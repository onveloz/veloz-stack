{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "env": {
    "browser": true,
    "node": true,
    "es2025": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "off",
    "nursery": "error"
  },
  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },
  "ignorePatterns": [
    "dist/**",
    ".next/**",
    "node_modules/**",
    ".turbo/**",
    "build/**",
    "**/template-generator/templates/**"
  ],
  "jsPlugins": ["oxlint-plugin-complexity"],
  "rules": {
    "no-debugger": "error",
    "react/react-in-jsx-scope": "off",
    "eslint/sort-keys": "off",
    "eslint/sort-imports": "off",
    "eslint/id-length": "off",
    "eslint/func-style": "off",
    "eslint/no-ternary": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-continue": "off",
    "eslint/capitalized-comments": "off",
    "eslint/require-unicode-regexp": "off",
    "eslint/max-statements": ["error", { "max": 50 }],
    "import/no-named-export": "off",
    "import/no-nodejs-modules": "off",
    "import/group-exports": "off",
    "import/prefer-default-export": "off",
    "import/exports-last": "off",
    "unicorn/no-null": "off",
    "unicorn/no-negated-condition": "off",
    "eslint/no-negated-condition": "off",
    "eslint/no-nested-ternary": "off",
    "unicorn/no-nested-ternary": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 50,
        "skipBlankLines": false,
        "skipComments": false,
        "IIFEs": false
      }
    ],
    "eslint/complexity": ["error", { "max": 10 }],
    "complexity/complexity": [
      "error",
      {
        "cyclomatic": 10,
        "cognitive": 10,
        "minLines": 5,
        "enableExtraction": true,
        "nestingTipThreshold": 3,
        "elseIfChainThreshold": 3,
        "logicalOperatorThreshold": 3
      }
    ],
    "oxc/no-barrel-file": ["error", { "threshold": 3 }],
    "import/no-cycle": ["error", { "maxDepth": 3 }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}", "**/__tests__/**"],
      "rules": {
        "eslint/max-lines-per-function": "off",
        "eslint/max-lines": "off",
        "eslint/complexity": "off",
        "complexity/complexity": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      "files": [
        "scripts/**",
        "**/*.mjs",
        "packages/template-generator/scripts/**",
        "apps/web/scripts/**"
      ],
      "rules": {
        "no-console": "off",
        "eslint/max-lines": "off",
        "eslint/no-inline-comments": "off",
        "eslint/no-underscore-dangle": "off",
        "eslint/complexity": "off",
        "complexity/complexity": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-misused-promises": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/prefer-nullish-coalescing": "off"
      }
    },
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "rules": {
        "react/jsx-max-depth": "off"
      }
    }
  ]
}
