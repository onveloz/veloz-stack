{
  "name": "veloz-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo -F @veloz-stack/web dev",
    "dev:cli": "turbo -F create-veloz-stack dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "prepare": "lefthook install",
    "sync-versions": "pnpm --filter @veloz-stack/template-generator sync-versions",
    "sync-versions:check": "pnpm --filter @veloz-stack/template-generator exec node scripts/sync-versions.mjs --check",
    "cli:link": "pnpm --filter create-veloz-stack build && pnpm --filter create-veloz-stack link --global"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10"
  }
}
