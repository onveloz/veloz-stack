{
  "name": "create-veloz-stack",
  "version": "0.0.1",
  "description": "Opinionated TypeScript scaffolder for Brazil — PIX, LGPD, SMS, Claude-ready. Deploys to Veloz.",
  "keywords": [
    "brasil",
    "brazilian",
    "bun",
    "hono",
    "orpc",
    "pix",
    "scaffolder",
    "starter",
    "tanstack",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "create-veloz-stack": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.mjs",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@veloz-stack/template-generator": "workspace:*",
    "@veloz-stack/types": "workspace:*",
    "chalk": "^5.4.1",
    "incur": "^0.4.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
