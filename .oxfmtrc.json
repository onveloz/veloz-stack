{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "dist/**",
    ".next/**",
    "node_modules/**",
    ".turbo/**",
    "build/**",
    "packages/template-generator/templates/**",
    "pnpm-lock.yaml"
  ]
}
