{
  "name": "@veloz-stack/template-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./scaffold": {
      "types": "./src/scaffold.ts",
      "default": "./src/scaffold.ts"
    }
  },
  "scripts": {
    "gen": "node scripts/build-templates.mjs",
    "prebuild": "pnpm gen",
    "check-types": "pnpm gen && tsc --noEmit",
    "test": "pnpm gen && vitest run",
    "test:watch": "vitest"
  },
  "files": ["src", "templates", "scripts"],
  "dependencies": {
    "@veloz-stack/types": "workspace:*",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
