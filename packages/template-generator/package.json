{
  "name": "@veloz-stack/template-generator",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "templates",
    "scripts"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./preview": {
      "types": "./src/preview.ts",
      "default": "./src/preview.ts"
    },
    "./scaffold": {
      "types": "./src/scaffold.ts",
      "default": "./src/scaffold.ts"
    }
  },
  "scripts": {
    "sync-versions": "node scripts/sync-versions.mjs",
    "gen": "node scripts/build-templates.mjs",
    "prebuild": "pnpm gen",
    "check-types": "pnpm gen && tsc --noEmit",
    "test": "pnpm gen && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@veloz-stack/types": "workspace:*",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.8.3"
  }
}
