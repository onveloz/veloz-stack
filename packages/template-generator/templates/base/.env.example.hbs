# App
NODE_ENV=development
APP_URL=http://localhost:3000

{{#if (ne db "none")}}
# Database
DATABASE_URL={{#if (eq db "postgres")}}postgres://postgres:postgres@localhost:5432/{{projectName}}{{else if (eq db "mysql")}}mysql://root:root@localhost:3306/{{projectName}}{{else if (eq db "sqlite")}}file:./data.db{{else}}mongodb://localhost:27017/{{projectName}}{{/if}}
{{/if}}

{{#if (eq auth "better-auth")}}
# Better Auth
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
{{/if}}
