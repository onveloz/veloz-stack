# App
NODE_ENV=development
{{#if (eq backend "next")}}
APP_URL=http://localhost:3001
{{else}}
APP_URL=http://localhost:3000
{{/if}}
{{#if (and (eq frontend "next") (ne backend "next"))}}
# URL do servidor da API (frontend Next em outra porta)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
{{/if}}
{{#if (eq frontend "tanstack-start")}}
# URL do servidor da API quando frontend e API rodam separados
VITE_SERVER_URL={{#if (eq backend "next")}}http://localhost:3001{{else}}http://localhost:3000{{/if}}
{{/if}}
{{#if (eq frontend "svelte-kit")}}
PUBLIC_SERVER_URL={{#if (eq backend "next")}}http://localhost:3001{{else}}http://localhost:3000{{/if}}
{{/if}}
{{#if (eq frontend "nuxt")}}
NUXT_PUBLIC_SERVER_URL={{#if (eq backend "next")}}http://localhost:3001{{else}}http://localhost:3000{{/if}}
{{/if}}
{{#if (eq frontend "astro")}}
PUBLIC_SERVER_URL={{#if (eq backend "next")}}http://localhost:3001{{else}}http://localhost:3000{{/if}}
{{/if}}
{{#if (eq mobile "expo")}}
# Expo aponta pro origin da API (Next same-origin ou Hono separado)
EXPO_PUBLIC_SERVER_URL={{#if (eq backend "next")}}http://localhost:3001{{else}}http://localhost:3000{{/if}}
{{/if}}

{{#if (ne db "none")}}
# Banco de dados
DATABASE_URL={{#if (eq db "postgres")}}postgres://postgres:postgres@localhost:5432/{{projectName}}{{else if (eq db "mysql")}}mysql://root:root@localhost:3306/{{projectName}}{{else if (eq db "sqlite")}}file:./data.db{{else}}mongodb://localhost:27017/{{projectName}}{{/if}}
{{/if}}

{{#if (eq auth "better-auth")}}
# Better Auth
BETTER_AUTH_SECRET=troque-por-32-bytes-aleatorios
{{#if (eq backend "next")}}
BETTER_AUTH_URL=http://localhost:3001
{{else}}
BETTER_AUTH_URL=http://localhost:3000
{{/if}}
{{/if}}
