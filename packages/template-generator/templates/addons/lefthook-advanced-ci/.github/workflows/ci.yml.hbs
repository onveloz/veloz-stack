# CI avançado — espelha Lefthook pre-push + validação de mensagens de commit.
name: ci

on:
  push:
    branches: [main, master]
  pull_request:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  quality:
    name: typecheck · biome ci · build{{#if (includes addons "turborepo")}} · test{{/if}}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      {{#if (eq pm "pnpm")}}
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      {{else}}{{#if (eq pm "bun")}}
      - uses: oven-sh/setup-bun@v2
      - run: bun install --frozen-lockfile
      {{else}}
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      {{/if}}{{/if}}

      {{#if (eq pm "pnpm")}}
      - name: Validate commit messages (PR)
        if: github.event_name == 'pull_request'
        run: pnpm exec commitlint --from \{{ github.event.pull_request.base.sha }} --to HEAD --verbose
      {{else}}{{#if (eq pm "bun")}}
      - name: Validate commit messages (PR)
        if: github.event_name == 'pull_request'
        run: bunx commitlint --from \{{ github.event.pull_request.base.sha }} --to HEAD --verbose
      {{else}}
      - name: Validate commit messages (PR)
        if: github.event_name == 'pull_request'
        run: npx commitlint --from \{{ github.event.pull_request.base.sha }} --to HEAD --verbose
      {{/if}}{{/if}}

      - name: Typecheck
        run: {{pmRun "check-types" pm}}

      {{#if (includes addons "biome")}}
      - name: Biome CI
        run: {{pmRun "lint:ci" pm}}
      {{/if}}

      - name: Build
        run: {{pmRun "build" pm}}

      {{#if (includes addons "turborepo")}}
      - name: Test
        run: {{pmRun "test" pm}}
      {{/if}}
