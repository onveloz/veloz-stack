import { {{#if (eq auth "better-auth")}}protectedProcedure, {{/if}}publicProcedure } from "../index";
import type { RouterClient } from "@orpc/server";
{{#if (eq auth "better-auth")}}
import { meOutputSchema, sessionOutputSchema, toPublicUser } from "../schemas/user";
{{/if}}
{{#if (and (includes examples "todo") (eq orm "drizzle"))}}
import { todoRouter } from "./todo";
{{/if}}
{{#if (and (includes examples "pix-checkout") (includes modules "abacatepay"))}}
import { checkoutRouter } from "./checkout";
{{/if}}

export const appRouter = {
  healthCheck: publicProcedure.handler(() => "OK"),
  {{#if (eq auth "better-auth")}}
  session: publicProcedure
    .output(sessionOutputSchema)
    .handler(({ context }) => ({
      user: context.session?.user ? toPublicUser(context.session.user) : null,
    })),
  me: protectedProcedure
    .output(meOutputSchema)
    .handler(({ context }) => ({
      user: toPublicUser(context.user),
    })),
  {{/if}}
  {{#if (and (includes examples "todo") (eq orm "drizzle"))}}
  todo: todoRouter,
  {{/if}}
  {{#if (and (includes examples "pix-checkout") (includes modules "abacatepay"))}}
  checkout: checkoutRouter,
  {{/if}}
};

export type AppRouter = typeof appRouter;
export type AppRouterClient = RouterClient<typeof appRouter>;
