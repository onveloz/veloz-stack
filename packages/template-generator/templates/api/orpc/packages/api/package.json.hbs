{
  "name": "@{{projectName}}/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./routers/index": "./src/routers/index.ts"
  },
  "dependencies": {
    "@orpc/server": "^1.12.2",
    "@orpc/zod": "^1.12.2",
    {{#if (eq auth "better-auth")}}
    "@{{projectName}}/auth": "workspace:*",
    {{/if}}
    {{#if (ne db "none")}}
    "@{{projectName}}/db": "workspace:*",
    {{/if}}
    {{#if (and (ne db "none") (eq orm "drizzle"))}}
    "drizzle-orm": "^0.36.0",
    {{/if}}
    {{#if (and (includes examples "pix-checkout") (includes modules "abacatepay"))}}
    "@{{projectName}}/abacatepay": "workspace:*",
    {{/if}}
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
