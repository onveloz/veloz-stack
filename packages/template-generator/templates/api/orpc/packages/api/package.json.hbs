{
  "name": "@{{projectName}}/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./routers/index": "./src/routers/index.ts"{{#if (eq auth "better-auth")}},
    "./schemas/user": "./src/schemas/user.ts"{{/if}}
  },
  "dependencies": {
    "@orpc/server": "{{version "@orpc/server"}}",
    "@orpc/zod": "{{version "@orpc/zod"}}",
    {{#if (eq auth "better-auth")}}
    "@{{projectName}}/auth": "workspace:*",
    {{/if}}
    {{#if (ne db "none")}}
    "@{{projectName}}/db": "workspace:*",
    {{/if}}
    {{#if (and (ne db "none") (eq orm "drizzle"))}}
    "drizzle-orm": "{{version "drizzle-orm"}}",
    {{/if}}
    {{#if (and (includes examples "pix-checkout") (includes modules "abacatepay"))}}
    "@{{projectName}}/abacatepay": "workspace:*",
    {{/if}}
    "zod": "{{version "zod"}}"
  },
  "devDependencies": {
    "typescript": "{{version "typescript"}}"
  }
}
