import { oz } from "@orpc/zod";

/** Public user fields returned by auth-aware oRPC routes. */
export const userSchema = oz.object({
  id: oz.string(),
  name: oz.string(),
  email: oz.string(),
  image: oz.string().nullable(),
});

export const sessionOutputSchema = oz.object({
  user: userSchema.nullable(),
});

export const meOutputSchema = oz.object({
  user: userSchema,
});

type AuthUser = {
  id: string;
  name: string;
  email: string;
  image?: string | null;
};

export function toPublicUser(user: AuthUser) {
  return {
    id: user.id,
    name: user.name,
    email: user.email,
    image: user.image ?? null,
  };
}
