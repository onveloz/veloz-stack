import { betterAuth } from "better-auth";
{{#if (eq backend "next")}}
import { nextCookies } from "better-auth/next-js";
{{/if}}
{{#if (eq orm "drizzle")}}
import { drizzleAdapter } from "better-auth/adapters/drizzle";
import { db, schema } from "@{{projectName}}/db";
{{else if (eq orm "prisma")}}
import { prismaAdapter } from "better-auth/adapters/prisma";
import { db } from "@{{projectName}}/db";
{{/if}}

const secret = process.env.BETTER_AUTH_SECRET;
if (!secret) {
  throw new Error("BETTER_AUTH_SECRET is required");
}

export const auth = betterAuth({
  {{#if (eq orm "drizzle")}}
  database: drizzleAdapter(db, {
    provider: "{{#if (eq db "postgres")}}pg{{else if (eq db "mysql")}}mysql{{else}}sqlite{{/if}}",
    schema,
  }),
  {{else if (eq orm "prisma")}}
  database: prismaAdapter(db, {
    provider: "{{#if (eq db "postgres")}}postgresql{{else if (eq db "mysql")}}mysql{{else if (eq db "sqlite")}}sqlite{{else}}mongodb{{/if}}",
  }),
  {{/if}}
  secret,
  baseURL: process.env.BETTER_AUTH_URL ?? "{{#if (eq backend "next")}}http://localhost:3001{{else}}http://localhost:3000{{/if}}",
  trustedOrigins: [process.env.APP_URL ?? "{{#if (eq backend "next")}}http://localhost:3001{{else}}http://localhost:3001{{/if}}"],
  emailAndPassword: { enabled: true },
  {{#if (eq backend "next")}}
  plugins: [nextCookies()],
  {{/if}}
  {{#if (includes modules "better-auth-social")}}
  socialProviders: {
    ...(process.env.GOOGLE_CLIENT_ID && process.env.GOOGLE_CLIENT_SECRET
      ? {
          google: {
            clientId: process.env.GOOGLE_CLIENT_ID,
            clientSecret: process.env.GOOGLE_CLIENT_SECRET,
          },
        }
      : {}),
    ...(process.env.GITHUB_CLIENT_ID && process.env.GITHUB_CLIENT_SECRET
      ? {
          github: {
            clientId: process.env.GITHUB_CLIENT_ID,
            clientSecret: process.env.GITHUB_CLIENT_SECRET,
          },
        }
      : {}),
    ...(process.env.APPLE_CLIENT_ID && process.env.APPLE_CLIENT_SECRET
      ? {
          apple: {
            clientId: process.env.APPLE_CLIENT_ID,
            clientSecret: process.env.APPLE_CLIENT_SECRET,
          },
        }
      : {}),
  },
  {{/if}}
  advanced: {
    defaultCookieAttributes: {
      {{#if (eq backend "next")}}
      sameSite: "lax",
      secure: process.env.NODE_ENV === "production",
      {{else}}
      sameSite: "none",
      secure: true,
      {{/if}}
      httpOnly: true,
    },
  },
});

export type Session = typeof auth.$Infer.Session;
