<script setup lang="ts">
import { ref, computed{{#unless (eq api "none")}}, onMounted{{/unless}} } from "vue";
import { signIn, signOut, signUp, useSession } from "../lib/auth-client";
{{#unless (eq api "none")}}
import { client } from "../composables/useOrpc";
{{/unless}}

const session = useSession();

const email = ref("");
const password = ref("");
const name = ref("");
const mode = ref<"sign-in" | "sign-up">("sign-in");
const error = ref<string | null>(null);
const loading = ref(false);
{{#unless (eq api "none")}}
const rpcUserId = ref<string | null>(null);
const rpcLoading = ref(true);

async function refreshRpcSession() {
  rpcLoading.value = true;
  try {
    const res = await client.session();
    if (res.user) {
      const me = await client.me();
      rpcUserId.value = me.user?.id ? String(me.user.id).slice(0, 8) : null;
    } else {
      rpcUserId.value = null;
    }
  } catch {
    rpcUserId.value = null;
  } finally {
    rpcLoading.value = false;
  }
}

onMounted(() => {
  void refreshRpcSession();
});
{{/unless}}

async function handleSubmit(event: Event) {
  event.preventDefault();
  error.value = null;
  loading.value = true;
  try {
    if (mode.value === "sign-up") {
      const res = await signUp.email({
        email: email.value,
        password: password.value,
        name: name.value,
      });
      if (res.error) throw new Error(res.error.message ?? "Falha ao criar conta");
    } else {
      const res = await signIn.email({
        email: email.value,
        password: password.value,
      });
      if (res.error) throw new Error(res.error.message ?? "Falha ao entrar");
    }
{{#unless (eq api "none")}}
    await refreshRpcSession();
{{/unless}}
  } catch (err) {
    error.value = err instanceof Error ? err.message : "Erro de autenticação";
  } finally {
    loading.value = false;
  }
}

async function handleSignOut() {
  loading.value = true;
  try {
    await signOut();
{{#unless (eq api "none")}}
    rpcUserId.value = null;
{{/unless}}
  } finally {
    loading.value = false;
  }
}

const user = computed(() => session.value.data?.user ?? null);
const sessionLoading = computed(() =>
  {{#unless (eq api "none")}}
  session.value.isPending || rpcLoading.value
  {{else}}
  session.value.isPending
  {{/unless}},
);
</script>

<template>
  <section class="section auth-panel">
    <h2>Autenticação</h2>
    <p class="auth-lede">
      Better Auth{{#unless (eq api "none")}}
      + oRPC — sessão via cookies e rotas <code>session</code> / <code>me</code>.
      {{else}}
      — sessão no cliente (sem camada RPC neste projeto).
      {{/unless}}
      <NuxtLink to="/login">Página de login →</NuxtLink>
    </p>

    <div class="auth-card">
      <div class="auth-status">
        <template v-if="sessionLoading">Carregando sessão…</template>
        <template v-else-if="user">
          Autenticado como \{{ user.name }} (\{{ user.email }})
          {{#unless (eq api "none")}}
          <div v-if="rpcUserId" class="auth-meta">
            oRPC <code>me</code>: \{{ rpcUserId }}…
          </div>
          {{/unless}}
        </template>
        <template v-else>Não autenticado</template>
      </div>

      <button
        v-if="user"
        type="button"
        class="auth-btn"
        :disabled="loading"
        @click="handleSignOut"
      >
        Sair
      </button>

      <form v-else class="auth-form" @submit="handleSubmit">
        <label>
          Modo
          <select v-model="mode">
            <option value="sign-in">Entrar</option>
            <option value="sign-up">Criar conta</option>
          </select>
        </label>
        <label v-if="mode === 'sign-up'">
          Nome
          <input v-model="name" required />
        </label>
        <label>
          Email
          <input v-model="email" type="email" required />
        </label>
        <label>
          Senha
          <input v-model="password" type="password" minlength="8" required />
        </label>
        <p v-if="error" class="auth-error">\{{ error }}</p>
        <button type="submit" class="auth-btn auth-btn-primary" :disabled="loading">
          \{{
            loading
              ? "Processando…"
              : mode === "sign-up"
                ? "Criar conta"
                : "Entrar"
          \}}
        </button>
      </form>
    </div>
  </section>
</template>

