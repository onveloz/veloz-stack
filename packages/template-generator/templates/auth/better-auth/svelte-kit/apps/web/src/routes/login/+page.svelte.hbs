<script lang="ts">
  import { signIn, signOut, signUp, useSession } from "$lib/auth-client";

  const session = useSession();

  let email = $state("");
  let password = $state("");
  let name = $state("");
  let mode = $state<"sign-in" | "sign-up">("sign-in");
  let error = $state<string | null>(null);
  let loading = $state(false);

  async function handleSubmit(event: SubmitEvent) {
    event.preventDefault();
    error = null;
    loading = true;
    try {
      if (mode === "sign-up") {
        const res = await signUp.email({ email, password, name });
        if (res.error) throw new Error(res.error.message ?? "Falha ao criar conta");
      } else {
        const res = await signIn.email({ email, password });
        if (res.error) throw new Error(res.error.message ?? "Falha ao entrar");
      }
    } catch (err) {
      error = err instanceof Error ? err.message : "Erro de autenticação";
    } finally {
      loading = false;
    }
  }

  async function handleSignOut() {
    loading = true;
    try {
      await signOut();
    } finally {
      loading = false;
    }
  }

  const user = $derived($session.data?.user ?? null);
</script>

<main class="dot-grid">
  <div class="shell">
    <div class="hero">
      <div class="hero-mark"></div>
      <h1>Entrar</h1>
    </div>

    <p class="lede">
      Better Auth — use email e senha. Depois volte pra <a href="/">home</a>.
    </p>

    <section class="section auth-panel">
      <div class="auth-card">
        <div class="auth-status">
          {#if $session.isPending}
            Carregando sessão…
          {:else if user}
            Autenticado como {user.name}. <a href="/">Ir pra home →</a>
          {:else}
            Faça login ou crie uma conta demo.
          {/if}
        </div>

        {#if user}
          <button type="button" class="auth-btn" disabled={loading} onclick={handleSignOut}>
            Sair
          </button>
        {:else}
          <form class="auth-form" onsubmit={handleSubmit}>
            <label>
              Modo
              <select bind:value={mode}>
                <option value="sign-in">Entrar</option>
                <option value="sign-up">Criar conta</option>
              </select>
            </label>
            {#if mode === "sign-up"}
              <label>
                Nome
                <input bind:value={name} required />
              </label>
            {/if}
            <label>
              Email
              <input type="email" bind:value={email} required />
            </label>
            <label>
              Senha
              <input type="password" bind:value={password} minlength="8" required />
            </label>
            {#if error}
              <p class="auth-error">{error}</p>
            {/if}
            <button type="submit" class="auth-btn auth-btn-primary" disabled={loading}>
              {loading ? "Processando…" : mode === "sign-up" ? "Criar conta" : "Entrar"}
            </button>
          </form>
        {/if}
      </div>
    </section>
  </div>
</main>

