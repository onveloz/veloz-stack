<script lang="ts">
  import { {{#unless (eq api "none")}}onMount,{{/unless}} } from "svelte";
  import { signIn, signOut, signUp, useSession } from "$lib/auth-client";
  {{#unless (eq api "none")}}
  import { client } from "$lib/orpc";
  {{/unless}}

  const session = useSession();

  let email = $state("");
  let password = $state("");
  let name = $state("");
  let mode = $state<"sign-in" | "sign-up">("sign-in");
  let error = $state<string | null>(null);
  let loading = $state(false);
  {{#unless (eq api "none")}}
  let rpcUserId = $state<string | null>(null);
  let rpcLoading = $state(true);

  async function refreshRpcSession() {
    rpcLoading = true;
    try {
      const res = await client.session();
      if (res.user) {
        const me = await client.me();
        rpcUserId = me.user?.id?.slice(0, 8) ?? null;
      } else {
        rpcUserId = null;
      }
    } catch {
      rpcUserId = null;
    } finally {
      rpcLoading = false;
    }
  }

  onMount(() => {
    void refreshRpcSession();
  });
  {{/unless}}

  async function handleSubmit(event: SubmitEvent) {
    event.preventDefault();
    error = null;
    loading = true;
    try {
      if (mode === "sign-up") {
        const res = await signUp.email({ email, password, name });
        if (res.error) throw new Error(res.error.message ?? "Falha ao criar conta");
      } else {
        const res = await signIn.email({ email, password });
        if (res.error) throw new Error(res.error.message ?? "Falha ao entrar");
      }
{{#unless (eq api "none")}}
      await refreshRpcSession();
{{/unless}}
    } catch (err) {
      error = err instanceof Error ? err.message : "Erro de autenticação";
    } finally {
      loading = false;
    }
  }

  async function handleSignOut() {
    loading = true;
    await signOut();
{{#unless (eq api "none")}}
    rpcUserId = null;
{{/unless}}
    loading = false;
  }

  const user = $derived($session.data?.user ?? null);
  const sessionLoading = $derived(
    {{#unless (eq api "none")}}
    $session.isPending || rpcLoading
    {{else}}
    $session.isPending
    {{/unless}},
  );
</script>

<section class="section auth-panel">
  <h2>Autenticação</h2>
  <p class="auth-lede">
    Better Auth{{#unless (eq api "none")}}
    + oRPC — sessão via cookies e rotas <code>session</code> / <code>me</code>.
    {{else}}
    — sessão no cliente (sem camada RPC neste projeto).
    {{/unless}}
    <a href="/login">Página de login →</a>
  </p>

  <div class="auth-card">
    <div class="auth-status">
      {#if sessionLoading}
        Carregando sessão…
      {:else if user}
        Autenticado como {user.name} ({user.email})
{{#unless (eq api "none")}}
        {#if rpcUserId}
          <div class="auth-meta">oRPC <code>me</code>: {rpcUserId}…</div>
        {/if}
{{/unless}}
      {:else}
        Não autenticado
      {/if}
    </div>

    {#if user}
      <button type="button" class="auth-btn" disabled={loading} onclick={handleSignOut}>
        Sair
      </button>
    {:else}
      <form class="auth-form" onsubmit={handleSubmit}>
        <label>
          Modo
          <select bind:value={mode}>
            <option value="sign-in">Entrar</option>
            <option value="sign-up">Criar conta</option>
          </select>
        </label>
        {#if mode === "sign-up"}
          <label>
            Nome
            <input bind:value={name} required />
          </label>
        {/if}
        <label>
          Email
          <input type="email" bind:value={email} required />
        </label>
        <label>
          Senha
          <input type="password" bind:value={password} minlength="8" required />
        </label>
        {#if error}
          <p class="auth-error">{error}</p>
        {/if}
        <button type="submit" class="auth-btn auth-btn-primary" disabled={loading}>
          {loading ? "Processando…" : mode === "sign-up" ? "Criar conta" : "Entrar"}
        </button>
      </form>
    {/if}
  </div>
</section>

