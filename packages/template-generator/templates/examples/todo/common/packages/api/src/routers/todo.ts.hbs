import { z } from "zod";
import { {{#if (eq auth "better-auth")}}and, {{/if}}eq, not } from "drizzle-orm";
import { db, schema } from "@{{projectName}}/db";
import {
  {{#if (eq auth "better-auth")}}ORPCError, {{/if}}
  {{#if (eq auth "better-auth")}}protectedProcedure{{else}}publicProcedure{{/if}},
} from "../index";

const procedure = {{#if (eq auth "better-auth")}}protectedProcedure{{else}}publicProcedure{{/if}};

export const todoRouter = {
  list: procedure.handler(async ({{#if (eq auth "better-auth")}}{ context }{{/if}}) => {
    {{#if (eq auth "better-auth")}}
    return db
      .select()
      .from(schema.todos)
      .where(eq(schema.todos.userId, context.user.id))
      .orderBy(schema.todos.createdAt);
    {{else}}
    return db.select().from(schema.todos).orderBy(schema.todos.createdAt);
    {{/if}}
  }),

  create: procedure
    .input(z.object({ title: z.string().min(1).max(200) }))
    .handler(async ({ input{{#if (eq auth "better-auth")}}, context{{/if}} }) => {
      const id = crypto.randomUUID();
      await db.insert(schema.todos).values({
        id,
        title: input.title,
        {{#if (eq auth "better-auth")}}
        userId: context.user.id,
        {{/if}}
      });
      return { id };
    }),

  toggle: procedure
    .input(z.object({ id: z.string().uuid() }))
    .handler(async ({ input{{#if (eq auth "better-auth")}}, context{{/if}} }) => {
      const [updated] = await db
        .update(schema.todos)
        .set({
          done: not(schema.todos.done),
          updatedAt: new Date(),
        })
        .where(
          {{#if (eq auth "better-auth")}}
          and(eq(schema.todos.id, input.id), eq(schema.todos.userId, context.user.id)),
          {{else}}
          eq(schema.todos.id, input.id),
          {{/if}}
        )
        .returning();
      if (!updated) {
        throw new {{#if (eq auth "better-auth")}}ORPCError("NOT_FOUND"){{else}}Error("Not found"){{/if}};
      }
    }),

  remove: procedure
    .input(z.object({ id: z.string().uuid() }))
    .handler(async ({ input{{#if (eq auth "better-auth")}}, context{{/if}} }) => {
      const result = await db
        .delete(schema.todos)
        .where(
          {{#if (eq auth "better-auth")}}
          and(eq(schema.todos.id, input.id), eq(schema.todos.userId, context.user.id))
          {{else}}
          eq(schema.todos.id, input.id)
          {{/if}}
        )
        .returning({ id: schema.todos.id });
      if (result.length === 0) {
        throw new {{#if (eq auth "better-auth")}}ORPCError("NOT_FOUND"){{else}}Error("Not found"){{/if}};
      }
    }),
};
