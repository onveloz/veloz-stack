import { createFileRoute } from "@tanstack/react-router";
import { useMutation, useQuery } from "@tanstack/react-query";
import { useState } from "react";
import { orpc } from "@/utils/orpc";

// biome-ignore lint/suspicious/noExplicitAny: mesmo padrão de stub que /desktop até routeTree.gen existe
export const Route = (createFileRoute as any)("/checkout")({
  component: CheckoutPage,
});

function CheckoutPage() {
  const [chargeId, setChargeId] = useState<string | null>(null);
  const [amount, setAmount] = useState(29.9);

  const create = useMutation(
    orpc.checkout.create.mutationOptions({
      onSuccess: (data) => setChargeId(data.id ?? null),
    }),
  );

  const status = useQuery(
    orpc.checkout.status.queryOptions({
      input: { id: chargeId ?? "" },
      enabled: !!chargeId,
      refetchInterval: 3_000,
    }),
  );

  const qrSrc =
    create.data?.brCodeBase64 && `data:image/png;base64,${create.data.brCodeBase64}`;
  const paid = status.data?.status === "PAID";

  return (
    <main className="min-h-screen bg-black text-white flex items-center justify-center p-8">
      <div className="max-w-md w-full space-y-6">
        <h1 className="text-2xl font-bold">PIX Checkout</h1>

        {!chargeId && (
          <form
            onSubmit={(e) => {
              e.preventDefault();
              create.mutate({ amountReais: amount, description: "Pedido demo" });
            }}
            className="space-y-4"
          >
            <label className="block">
              <span className="text-xs uppercase tracking-wider text-white/60">
                Valor (R$)
              </span>
              <input
                type="number"
                step="0.01"
                min={0.01}
                value={amount}
                onChange={(e) => setAmount(Number(e.target.value))}
                className="mt-1 w-full bg-white/5 border border-white/10 px-3 h-10 font-mono"
              />
            </label>
            <button
              type="submit"
              disabled={create.isPending}
              className="h-10 px-4 bg-[#FF4D00] text-white font-medium w-full disabled:opacity-50"
            >
              {create.isPending ? "Gerando QR…" : "Gerar PIX"}
            </button>
            {create.error && (
              <p className="text-red-400 text-sm">{String(create.error.message)}</p>
            )}
          </form>
        )}

        {chargeId && !paid && (
          <div className="space-y-4">
            {qrSrc ? (
              <img src={qrSrc} alt="PIX QR" className="mx-auto bg-white p-2 w-64 h-64" />
            ) : null}
            {create.data?.brCode && (
              <div className="border border-white/10 bg-white/5 p-3 break-all font-mono text-xs">
                {create.data.brCode}
              </div>
            )}
            <p className="text-sm text-white/60 text-center">
              Status: <span className="text-white">{status.data?.status ?? "PENDING"}</span>
            </p>
          </div>
        )}

        {paid && (
          <div className="text-center space-y-2">
            <div className="text-4xl">✓</div>
            <p className="text-green-400 font-medium">Pagamento recebido.</p>
          </div>
        )}
      </div>
    </main>
  );
}
