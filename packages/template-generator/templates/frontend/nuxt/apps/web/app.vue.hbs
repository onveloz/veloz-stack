<script setup lang="ts">
import { ref, onMounted } from "vue";
import { client } from "./composables/useOrpc";

const healthStatus = ref<"loading" | "ok" | "error">("loading");

onMounted(async () => {
  try {
    const res = await client.healthCheck();
    healthStatus.value = res === "OK" ? "ok" : "error";
  } catch {
    healthStatus.value = "error";
  }
});
</script>

<template>
  <main>
    <div class="hero">
      <div class="brand-dot" />
      <h1>{{projectName}}</h1>
    </div>
    <p class="muted">
      Scaffolded with <code>create-veloz-stack</code>. Edit
      <code>apps/web/app.vue</code> to start.
    </p>
    <section class="status">
      <div class="label">API status</div>
      <div class="row">
        <span
          class="dot"
          :class="{
            ok: healthStatus === 'ok',
            loading: healthStatus === 'loading',
            error: healthStatus === 'error',
          }"
        />
        <span>
          \{{ healthStatus === "loading" ? "Checking…" : healthStatus === "ok" ? "Connected" : "Disconnected" }}
        </span>
      </div>
    </section>
  </main>
</template>

