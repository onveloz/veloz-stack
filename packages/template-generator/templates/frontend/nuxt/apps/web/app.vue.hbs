<script setup lang="ts">
import { ref, onMounted, computed } from "vue";
import { client } from "./composables/useOrpc";

const healthStatus = ref<"loading" | "ok" | "error">("loading");

onMounted(async () => {
  try {
    const res = await client.healthCheck();
    healthStatus.value = res === "OK" ? "ok" : "error";
  } catch {
    healthStatus.value = "error";
  }
});

const statusLabel = computed(() =>
  healthStatus.value === "loading"
    ? "Verificando API…"
    : healthStatus.value === "ok"
    ? "API conectada"
    : "API desconectada",
);

const STACK: Array<{ label: string; brand?: boolean }> = [
  { label: "{{frontend}}", brand: true },
  { label: "{{backend}}" },
  { label: "{{runtime}}" },
  { label: "{{api}}" },
  { label: "{{db}}" },
  { label: "{{orm}}" },
  { label: "{{auth}}" },
].filter((s) => s.label !== "none");

const MODULES: string[] = {{{json modules}}};
</script>

<template>
  <main class="dot-grid">
    <div class="shell">
      <span class="status-pill" :class="`pill-${healthStatus}`">
        <span class="pill-dot" />
        \{{ statusLabel }}
      </span>

      <div class="hero">
        <div class="hero-mark" />
        <h1>{{projectName}}</h1>
      </div>

      <p class="lede">
        Stack <strong>{{frontend}} + {{backend}} + {{api}}</strong> no ar. Edite
        <code>apps/web/app.vue</code> ou abra o <code>CLAUDE.md</code> e peça
        ajuda pro agente.
      </p>

      <section class="section">
        <h2>Próximos passos</h2>
        <div class="steps">
          <div class="step">
            <div class="step-title">Edite a home</div>
            <div class="step-body">
              Substitua <code>apps/web/app.vue</code>.
            </div>
          </div>
          <div class="step">
            <div class="step-title">Peça ajuda pro Claude</div>
            <div class="step-body">
              <code>CLAUDE.md</code> e <code>.claude/skills/</code> ensinam seu
              agente sobre o stack.
            </div>
          </div>
          {{#if (eq deploy "veloz")}}
          <div class="step">
            <div class="step-title">Deploy no Veloz</div>
            <div class="step-body">
              Rode <code>npx onveloz deploy</code> na raiz.
            </div>
          </div>
          {{/if}}
          {{#if (ne db "none")}}
          <div class="step">
            <div class="step-title">Aplique o schema</div>
            <div class="step-body">
              Rode <code>{{pm}} db:push</code> pra criar as tabelas.
            </div>
          </div>
          {{/if}}
        </div>
      </section>

      <section class="section">
        <h2>No seu stack</h2>
        <div class="tag-row">
          <span
            v-for="s in STACK"
            :key="s.label"
            class="tag"
            :class="{ brand: s.brand }"
          >
            \{{ s.label }}
          </span>
        </div>
      </section>

      <section v-if="MODULES.length > 0" class="section">
        <h2>Módulos ativos</h2>
        <div class="tag-row">
          <span v-for="m in MODULES" :key="m" class="tag">\{{ m }}</span>
        </div>
      </section>

      <section class="quick-links">
        <a href="https://onveloz.com/docs" target="_blank" rel="noreferrer">
          Docs da Veloz →
        </a>
        <a href="https://veloz-stack.runveloz.com" target="_blank" rel="noreferrer">
          Veloz Stack →
        </a>
        <a
          href="https://github.com/onveloz/veloz-stack"
          target="_blank"
          rel="noreferrer"
        >
