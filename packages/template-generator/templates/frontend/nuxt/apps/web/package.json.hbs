{
  "name": "@{{projectName}}/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3001",
    "build": "nuxt build",
    "start": "nuxt preview --port 3001",
    "prepare": "nuxt prepare",
    "check-types": "nuxt prepare && nuxt typecheck"
  },
  "dependencies": {
    {{#unless (eq api "none")}}
    "@{{projectName}}/api": "workspace:*",
    "@orpc/client": "{{version "@orpc/client"}}",
    "@orpc/server": "{{version "@orpc/server"}}",
    {{/unless}}
    {{#if (eq auth "better-auth")}}
    "better-auth": "{{version "better-auth"}}",
    {{/if}}
    "@tanstack/vue-query": "{{version "@tanstack/vue-query"}}",
    "nuxt": "{{version "nuxt"}}",
    "vue": "{{version "vue"}}"
  },
  "devDependencies": {
    "@nuxt/kit": "{{version "@nuxt/kit"}}",
    "typescript": "{{version "typescript"}}",
    "vue-tsc": "{{version "vue-tsc"}}"
  }
}
