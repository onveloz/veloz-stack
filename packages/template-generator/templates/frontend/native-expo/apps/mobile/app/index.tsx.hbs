  },
  subtitle: {
    color: "rgba(255,255,255,0.6)",
    fontSize: 14,
    marginBottom: 24,
  },
  statusCard: {
    borderWidth: 1,
    borderColor: "rgba(255,255,255,0.1)",
    backgroundColor: "rgba(255,255,255,0.05)",
    padding: 16,
  },
  statusLabel: {
