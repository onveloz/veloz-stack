import { useQuery } from "@tanstack/react-query";
import { View, Text, StyleSheet } from "react-native";
import { orpc } from "@/lib/orpc";

export default function Home() {
  const health = useQuery(orpc.healthCheck.queryOptions());
  const dotColor =
    health.data === "OK" ? "#16a34a" : health.isLoading ? "#d97706" : "#dc2626";
  const statusText = health.isLoading
    ? "Verificando…"
    : health.data === "OK"
    ? "Conectado"
    : "Desconectado";

  return (
    <View style={styles.container}>
      <View style={styles.hero}>
        <View style={styles.brandDot} />
        <Text style={styles.title}>{{projectName}}</Text>
      </View>
      <Text style={styles.subtitle}>
        Gerado com create-veloz-stack. Edite apps/mobile/app/index.tsx pra começar.
      </Text>
      <View style={styles.statusCard}>
        <Text style={styles.statusLabel}>Status da API</Text>
        <View style={styles.statusRow}>
          <View style={[styles.statusDot, { backgroundColor: dotColor }]} />
          <Text style={styles.statusText}>{statusText}</Text>
        </View>
      </View>
    </View>
  );
}

