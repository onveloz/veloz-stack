<script lang="ts">
  import { onMount } from "svelte";
  import { client } from "$lib/orpc";

  let status = $state<"loading" | "ok" | "error">("loading");

  onMount(async () => {
    try {
      const res = await client.healthCheck();
      status = res === "OK" ? "ok" : "error";
    } catch {
      status = "error";
    }
  });
</script>

<main>
  <div class="hero">
    <div class="brand-dot"></div>
    <h1>{{projectName}}</h1>
  </div>
  <p class="muted">
    Scaffolded with <code>create-veloz-stack</code>. Edit
    <code>apps/web/src/routes/+page.svelte</code> to start.
  </p>
  <section class="status">
    <div class="label">API status</div>
    <div class="row">
      <span class="dot" class:ok={status === "ok"} class:loading={status === "loading"} class:error={status === "error"}></span>
      <span>
        {#if status === "loading"}Checking…{:else if status === "ok"}Connected{:else}Disconnected{/if}
      </span>
    </div>
  </section>
</main>

