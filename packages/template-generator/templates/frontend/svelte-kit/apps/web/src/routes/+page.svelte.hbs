<script lang="ts">
  import { onMount } from "svelte";
  import { client } from "$lib/orpc";
  {{#if (eq auth "better-auth")}}
  import AuthPanel from "$lib/AuthPanel.svelte";
  {{/if}}

  let status = $state<"loading" | "ok" | "error">("loading");

  onMount(async () => {
    try {
      const res = await client.healthCheck();
      status = res === "OK" ? "ok" : "error";
    } catch {
      status = "error";
    }
  });

  const statusLabel = $derived(
    status === "loading"
      ? "Verificando API…"
      : status === "ok"
        ? "API conectada"
        : "API desconectada",
  );

  const STACK = [
    { label: "{{frontend}}", brand: true },
    { label: "{{backend}}" },
    { label: "{{runtime}}" },
    { label: "{{api}}" },
    { label: "{{db}}" },
    { label: "{{orm}}" },
    { label: "{{auth}}" },
  ].filter((s) => s.label !== "none");

  const MODULES: string[] = {{{json modules}}};
</script>

<main class="dot-grid">
  <div class="shell">
    <span class="status-pill pill-{status}">
      <span class="pill-dot"></span>
      {statusLabel}
    </span>

    <div class="hero">
      <div class="hero-mark"></div>
      <h1>{{projectName}}</h1>
    </div>

    <p class="lede">
      Stack <strong>{{frontend}} + {{backend}} + {{api}}</strong> no ar. Edite
      <code>apps/web/src/routes/+page.svelte</code> ou abra o
      <code>CLAUDE.md</code> e peça ajuda pro agente.
    </p>

    {{#if (eq auth "better-auth")}}
    <AuthPanel />
    {{/if}}

    <section class="section">
      <h2>Próximos passos</h2>
      <div class="steps">
        <div class="step">
          <div class="step-title">Edite a home</div>
          <div class="step-body">
            Substitua <code>apps/web/src/routes/+page.svelte</code>.
          </div>
        </div>
        <div class="step">
          <div class="step-title">Peça ajuda pro Claude</div>
          <div class="step-body">
            <code>CLAUDE.md</code> e <code>.claude/skills/</code> ensinam seu
            agente sobre o stack.
          </div>
        </div>
        {{#if (eq deploy "veloz")}}
        <div class="step">
          <div class="step-title">Deploy no Veloz</div>
          <div class="step-body">
            Rode <code>npx onveloz deploy</code> na raiz.
          </div>
        </div>
        {{/if}}
        {{#if (ne db "none")}}
        <div class="step">
          <div class="step-title">Aplique o schema</div>
          <div class="step-body">
            Rode <code>{{pm}} db:push</code> pra criar as tabelas.
          </div>
        </div>
        {{/if}}
      </div>
    </section>

    <section class="section">
      <h2>No seu stack</h2>
      <div class="tag-row">
        {#each STACK as s (s.label)}
          <span class="tag" class:brand={s.brand}>{s.label}</span>
        {/each}
      </div>
    </section>

    {#if MODULES.length > 0}
      <section class="section">
        <h2>Módulos ativos</h2>
        <div class="tag-row">
          {#each MODULES as m (m)}
            <span class="tag">{m}</span>
          {/each}
        </div>
      </section>
    {/if}

    <section class="quick-links">
      <a href="https://onveloz.com/docs" target="_blank" rel="noreferrer">
        Docs da Veloz →
      </a>
      <a href="https://www.veloz-stack.com" target="_blank" rel="noreferrer">
        Veloz Stack →
      </a>
      <a
        href="https://github.com/onveloz/veloz-stack"
        target="_blank"
        rel="noreferrer"
      >
        GitHub →
      </a>
    </section>

    <footer class="footer">
      Gerado com <code>create-veloz-stack</code> · feito no Brasil 🇧🇷
    </footer>
  </div>
</main>

