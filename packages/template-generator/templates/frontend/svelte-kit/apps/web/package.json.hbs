{
  "name": "@{{projectName}}/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "start": "node build",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    {{#unless (eq api "none")}}
    "@{{projectName}}/api": "workspace:*",
    "@orpc/client": "{{version "@orpc/client"}}",
    "@orpc/server": "{{version "@orpc/server"}}"{{#if (eq auth "better-auth")}},{{/if}}
    {{/unless}}
    {{#if (eq auth "better-auth")}}
    "better-auth": "{{version "better-auth"}}"
    {{/if}}
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "{{version "@sveltejs/adapter-node"}}",
    "@sveltejs/kit": "{{version "@sveltejs/kit"}}",
    "@sveltejs/vite-plugin-svelte": "{{version "@sveltejs/vite-plugin-svelte"}}",
    "svelte": "{{version "svelte"}}",
    "svelte-check": "{{version "svelte-check"}}",
    "typescript": "{{version "typescript"}}",
    "vite": "{{version "vite"}}"
  }
}
