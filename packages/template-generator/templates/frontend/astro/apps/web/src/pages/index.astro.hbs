---
import Layout from "../layouts/Layout.astro";
import HealthIsland from "../components/HealthIsland";
---

<Layout title="{{projectName}}">
  <main>
    <div class="hero">
      <div class="brand-dot"></div>
      <h1>{{projectName}}</h1>
    </div>
    <p class="muted">
      Scaffolded with <code>create-veloz-stack</code>. Edit
      <code>apps/web/src/pages/index.astro</code> to start.
    </p>
    <HealthIsland client:load />
  </main>
</Layout>

<style>
  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem;
  }
  .hero {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .brand-dot {
    width: 12px;
    height: 12px;
    background: #ff4d00;
  }
  h1 {
    font-size: 1.75rem;
    font-weight: 700;
  }
  .muted {
    color: rgba(255, 255, 255, 0.6);
  }
  code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0 4px;
  }
</style>
