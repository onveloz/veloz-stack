{{#unless (eq api "none")}}
import { useQuery, QueryClient, QueryClientProvider } from "@tanstack/react-query";
{{else}}
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
{{/unless}}
import { useState } from "react";
{{#unless (eq api "none")}}
import { orpc } from "../lib/orpc";
{{/unless}}

function Inner() {
{{#unless (eq api "none")}}
  const q = useQuery(orpc.healthCheck.queryOptions());
  const color =
    q.data === "OK" ? "#16a34a" : q.isLoading ? "#d97706" : "#dc2626";

  return (
    <div
      style=\{{
        border: "1px solid rgba(255,255,255,0.1)",
        background: "rgba(255,255,255,0.05)",
        padding: 16,
        marginTop: 16,
      }}
    >
      <div
        style=\{{
          fontSize: 11,
          textTransform: "uppercase",
          letterSpacing: "0.06em",
          color: "rgba(255,255,255,0.5)",
          marginBottom: 8,
        }}
      >
        API status
      </div>
      <div style=\{{ display: "flex", alignItems: "center", gap: 8 }}>
        <span
          style=\{{ width: 8, height: 8, background: color, display: "inline-block" }}
        />
        <span style=\{{ fontSize: 14 }}>
          {q.isLoading ? "Checking…" : q.data === "OK" ? "Connected" : "Disconnected"}
        </span>
      </div>
    </div>
  );
{{else}}
  return (
    <div
      style=\{{
        border: "1px solid rgba(255,255,255,0.1)",
        background: "rgba(255,255,255,0.05)",
        padding: 16,
        marginTop: 16,
      }}
    >
      <div
        style=\{{
          fontSize: 11,
          textTransform: "uppercase",
          letterSpacing: "0.06em",
          color: "rgba(255,255,255,0.5)",
          marginBottom: 8,
        }}
      >
        API status
      </div>
      <div style=\{{ display: "flex", alignItems: "center", gap: 8 }}>
        <span
          style=\{{ width: 8, height: 8, background: "#737373", display: "inline-block" }}
        />
        <span style=\{{ fontSize: 14 }}>Sem camada RPC (stack com api: none)</span>
      </div>
    </div>
  );
{{/unless}}
}

export default function HealthIsland() {
  const [qc] = useState(() => new QueryClient());
  return (
    <QueryClientProvider client={qc}>
      <Inner />
    </QueryClientProvider>
  );
}
