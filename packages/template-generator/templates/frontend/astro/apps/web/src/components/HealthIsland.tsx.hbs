{{#unless (eq api "none")}}
import { useQuery, QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { useState } from "react";
import { orpc } from "../lib/orpc";
{{/unless}}

const shellStyle = {
  border: "1px solid rgba(255,255,255,0.1)",
  background: "rgba(255,255,255,0.05)",
  padding: 16,
  marginTop: 16,
} as const;

const labelStyle = {
  fontSize: 11,
  textTransform: "uppercase" as const,
  letterSpacing: "0.06em",
  color: "rgba(255,255,255,0.5)",
  marginBottom: 8,
};

function StatusRow({ color, label }: { color: string; label: string }) {
  return (
    <div style={shellStyle}>
      <div style={labelStyle}>API status</div>
      <div style=\{{ display: "flex", alignItems: "center", gap: 8 }}>
        <span
          style=\{{ width: 8, height: 8, background: color, display: "inline-block" }}
        />
        <span style=\{{ fontSize: 14 }}>{label}</span>
      </div>
    </div>
  );
}

function Inner() {
{{#unless (eq api "none")}}
  const q = useQuery(orpc.healthCheck.queryOptions());
  const color =
    q.data === "OK" ? "#16a34a" : q.isLoading ? "#d97706" : "#dc2626";
  const label =
    q.isLoading ? "Checking…" : q.data === "OK" ? "Connected" : "Disconnected";

  return <StatusRow color={color} label={label} />;
{{else}}
  return (
    <StatusRow
      color="#737373"
      label="No RPC layer (stack with api: none)"
    />
  );
{{/unless}}
}

export default function HealthIsland() {
{{#unless (eq api "none")}}
  const [qc] = useState(() => new QueryClient());
  return (
    <QueryClientProvider client={qc}>
      <Inner />
    </QueryClientProvider>
  );
{{else}}
  return <Inner />;
{{/unless}}
}
