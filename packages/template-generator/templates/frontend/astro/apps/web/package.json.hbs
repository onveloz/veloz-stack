{
  "name": "@{{projectName}}/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3001",
    "build": "astro build",
    "start": "astro preview --port 3001",
    "check-types": "astro check"
  },
  "dependencies": {
    {{#unless (eq api "none")}}
    "@{{projectName}}/api": "workspace:*",
    "@orpc/client": "{{version "@orpc/client"}}",
    "@orpc/server": "{{version "@orpc/server"}}",
    "@orpc/tanstack-query": "{{version "@orpc/tanstack-query"}}",
    {{/unless}}
    {{#if (eq auth "better-auth")}}
    "better-auth": "{{version "better-auth"}}",
    {{/if}}
    "@astrojs/node": "{{version "@astrojs/node"}}",
    "@astrojs/react": "{{version "@astrojs/react"}}",
    "@tanstack/react-query": "{{version "@tanstack/react-query"}}",
    "astro": "{{version "astro"}}",
    "react": "{{version "react"}}",
    "react-dom": "{{version "react-dom"}}"
  },
  "devDependencies": {
    "@astrojs/check": "{{version "@astrojs/check"}}",
    "@types/react": "{{version "@types/react"}}",
    "@types/react-dom": "{{version "@types/react-dom"}}",
    "typescript": "{{version "typescript"}}"
  }
}
