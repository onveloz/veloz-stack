    {{/if}}
    "@orpc/client": "^1.12.2",
    "@orpc/server": "^1.12.2",
    "@orpc/tanstack-query": "^1.12.2",
    {{#if (and (eq backend "next") (eq auth "better-auth"))}}
    "better-auth": "^1.4.18",
    {{/if}}
    "@tanstack/react-query": "^5.80.6",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.5",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  }
