{
  "name": "@{{projectName}}/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@{{projectName}}/api": "workspace:*",
    {{#if (eq auth "better-auth")}}
