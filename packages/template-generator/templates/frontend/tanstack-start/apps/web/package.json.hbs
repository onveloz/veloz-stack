{
  "name": "@{{projectName}}/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "start": "vite preview --port 3001",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@{{projectName}}/api": "workspace:*",
    {{#if (eq auth "better-auth")}}
    "@{{projectName}}/auth": "workspace:*",
    {{/if}}
    "@orpc/client": "{{version "@orpc/client"}}",
    "@orpc/server": "{{version "@orpc/server"}}",
    "@orpc/tanstack-query": "{{version "@orpc/tanstack-query"}}",
    "@tailwindcss/vite": "{{version "@tailwindcss/vite"}}",
    "@tanstack/react-query": "{{version "@tanstack/react-query"}}",
    "@tanstack/react-router": "{{version "@tanstack/react-router"}}",
    "@tanstack/react-router-with-query": "{{version "@tanstack/react-router-with-query"}}",
    "@tanstack/react-start": "{{version "@tanstack/react-start"}}",
    "lucide-react": "{{version "lucide-react"}}",
    "react": "{{version "react"}}",
    "react-dom": "{{version "react-dom"}}",
    "sonner": "{{version "sonner"}}",
    "tailwindcss": "{{version "tailwindcss"}}"
  },
  "devDependencies": {
    "@tanstack/react-router-devtools": "{{version "@tanstack/react-router-devtools"}}",
    "@tanstack/router-plugin": "{{version "@tanstack/router-plugin"}}",
    "@types/react": "{{version "@types/react"}}",
    "@types/react-dom": "{{version "@types/react-dom"}}",
    "@vitejs/plugin-react": "{{version "@vitejs/plugin-react"}}",
    "typescript": "{{version "typescript"}}",
    "vite": "{{version "vite"}}",
    "vite-tsconfig-paths": "{{version "vite-tsconfig-paths"}}"
  }
}
