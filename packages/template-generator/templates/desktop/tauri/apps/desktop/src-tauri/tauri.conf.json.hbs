{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{projectName}}",
  "version": "0.0.0",
  "identifier": "com.{{projectName}}.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "{{pm}} --filter @{{projectName}}/web dev",
    "beforeBuildCommand": "{{pm}} --filter @{{projectName}}/web build"
  },
  "app": {
    "windows": [
      {
        "title": "{{projectName}}",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "{{projectName}} desktop",
    "longDescription": "{{projectName}} — desktop shell gerado com create-veloz-stack"
  }
}
