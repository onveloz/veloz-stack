import { createORPCClient } from "@orpc/client";
import { RPCLink } from "@orpc/client/fetch";
import { createTanstackQueryUtils } from "@orpc/tanstack-query";
import type { AppRouter } from "@{{projectName}}/api/routers/index";
import type { RouterClient } from "@orpc/server";

// Point EXPO_PUBLIC_SERVER_URL at your dev machine's LAN IP when testing
// on device (e.g. http://192.168.1.20:3000) — localhost resolves to the
// emulator / simulator loopback.
const serverUrl =
  process.env.EXPO_PUBLIC_SERVER_URL ?? "http://localhost:3000";

const link = new RPCLink({
  url: `${serverUrl}/rpc`,
  {{#if (eq auth "better-auth")}}
  fetch: (url, options) => fetch(url, { ...options, credentials: "include" }),
  {{/if}}
});

export const client = createORPCClient(link) as RouterClient<AppRouter>;
export const orpc = createTanstackQueryUtils(client);
