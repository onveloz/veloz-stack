{
  "name": "@{{projectName}}/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo prebuild",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    {{#unless (eq api "none")}}
    "@{{projectName}}/api": "workspace:*",
    "@orpc/client": "{{version "@orpc/client"}}",
    "@orpc/server": "{{version "@orpc/server"}}",
    "@orpc/tanstack-query": "{{version "@orpc/tanstack-query"}}",
    {{/unless}}
    {{#if (eq auth "better-auth")}}
    "@better-auth/expo": "{{version "@better-auth/expo"}}",
    "better-auth": "{{version "better-auth"}}",
    "expo-secure-store": "{{version "expo-secure-store"}}",
    {{/if}}
    "@tanstack/react-query": "{{version "@tanstack/react-query"}}",
    "expo": "{{version "expo"}}",
    "expo-router": "{{version "expo-router"}}",
    "expo-status-bar": "{{version "expo-status-bar"}}",
    "react": "{{version "react"}}",
    "react-native": "{{version "react-native"}}",
    "react-native-safe-area-context": "{{version "react-native-safe-area-context"}}",
    "react-native-screens": "{{version "react-native-screens"}}"
  },
  "devDependencies": {
    "@types/react": "{{version "@types/react"}}",
    "typescript": "{{version "typescript"}}"
  }
}
